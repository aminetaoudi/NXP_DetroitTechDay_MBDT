<?xml version="1.0" encoding="utf-8"?>
<ModelInformation Version="1.0">
  <Model>
    <P Name="ModelUUID">21cf8370-89a9-439e-8616-c47d9d7bc0b9</P>
    <P Name="PreLoadFcn">% NXP_MBDT_S32ZE callback: DO NOT REMOVE
mbd_s32ze.common.nxp.model_callbacks.preLoadFcn();</P>
    <P Name="PostLoadFcn">Increment = Simulink.Parameter;
Increment.DataType = &apos;uint8&apos;;
Increment.CoderInfo.StorageClass = &apos;SimulinkGlobal&apos;;
Increment.Value = 1;

SilCounterBus = Simulink.Bus;
SilCounterBus.Description = &apos;This bus contains counter inputs&apos;;

e1 = Simulink.BusElement;
e1.DataType = &apos;boolean&apos;;
e1.Name = &apos;ticks_to_count&apos;;

e2 = Simulink.BusElement;
e2.DataType = &apos;boolean&apos;;
e2.Name = &apos;reset&apos;;

SilCounterBus.Elements = [e1 e2];
clear e1 e2

% Step size
T=0.1;

% Input values
ticks_to_count.time = (0:100)&apos;*T;
ticks_to_count.signals.values = boolean((floor( (0:100)/2)==(0:100)/2)&apos;);
ticks_to_count.signals.dimensions = 1;

reset.time = (0:100)&apos;*T;
reset_values = boolean(zeros(101,1)); reset_values(20)=true;
reset.signals.values = reset_values;
clear reset_values
reset.signals.dimensions = 1;
% NXP_MBDT_S32ZE callback: DO NOT REMOVE
mbd_s32ze.common.nxp.model_callbacks.postLoadFcn();</P>
    <P Name="DataDictionary">s32ze_counter_pil_simulink_r52.sldd</P>
