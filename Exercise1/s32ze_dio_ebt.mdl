&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; color:#000000;&quot;&gt;1. Check &lt;/span&gt;&lt;a href=&quot;matlab:open s32ze_dio_ebt_example_readme.html&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; text-decoration: underline; color:#0000ff;&quot;&gt;HW and SW setup&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;
&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; color:#000000;&quot;&gt;2. Check this model &lt;/span&gt;&lt;a href=&quot;matlab:openDialog(getActiveConfigSet(gcs));&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; text-decoration: underline; color:#0000ff;&quot;&gt;settings&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;
&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; color:#000000;&quot;&gt;3. &lt;/span&gt;&lt;a href=&quot;matlab:rtwbuild(gcs);&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; text-decoration: underline; color:#0000ff;&quot;&gt;Generate Code, Build &amp;amp; Deploy&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12px; color:#000000;&quot;&gt; on EVB&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</P>
    <P Name="Tag">ModelFeatures</P>
    <P Name="Position">[-640, -199, -17, -130]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="FixedHeight">on</P>
    <P Name="FixedWidth">on</P>
    <P Name="Interpreter">rich</P>
    <P Name="ZOrder">-1</P>
  </Annotation>
  <Annotation SID="184">
    <P Name="Name">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;p, li { white-space: pre-wrap; }&lt;/style&gt;&lt;/head&gt;&lt;body align=&quot;left&quot; style=&quot; font-family:&apos;Helvetica&apos;; font-size:10px; font-weight:400; font-style:normal;&quot;&gt;&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Copyright 2022-2024 NXP&lt;/span&gt;&lt;/p&gt; &lt;p align=&quot;left&quot; style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:12px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;SPDX-License-Identifier: BSD-3-Clause&lt;/span&gt;&lt;/p&gt; &lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;The BSD-3-Clause license can be found at &lt;/span&gt;&lt;span style=&quot; font-size:12px; text-decoration: underline; color:#0000ff;&quot;&gt;https://spdx.org/licenses/BSD-3-Clause.html&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</P>
